---
import App from "../components/App";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// 링크 미리보기(카카오톡·LINE·Slack 등)는 절대 주소가 필요하다. SITE가 없으면(로컬) 상대 주소로 둔다.
const site = Astro.site ? new URL(base, Astro.site).href : base;
const description =
  "Japan & international security news, summarized by AI. 日本・国際のセキュリティニュースを AI 要約でまとめた個人ダッシュボード";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Security Glance" />
    <meta property="og:title" content="Security Glance" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <!-- Safari 상단·하단 바 색: 사이트 상단 바(흰색 / 어두운 회색)와 맞춰 이어 보이게. 그라데이션은 받지 않아 단색만 -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#292929" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>Security Glance</title>
    <style is:global>
      :root {
        --page-bg: #fafafa;
        --page-fg: #616161;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --page-bg: #1f1f1f;
          --page-fg: #adadad;
        }
      }
      html,
      body {
        margin: 0;
        background: var(--page-bg);
      }
      /* 줄바꿈. 상세 패널·메뉴는 포털로 앱 밖에 그려지므로 <html>에 걸어 상속시킨다.
         - 한국어: 어절(띄어쓰기) 단위로만
         - 일본어: 띄어쓰기가 없어 문절(구) 단위로 (word-break: auto-phrase). 모르는 브라우저는 앞의 normal + 금칙 처리
         - 영어: 낱말 단위로 (기본값. 하이픈 자동 삽입은 하지 않는다)
         - 공통: 끝줄에 한두 글자만 남지 않게(pretty), 제목은 줄 길이를 고르게(balance),
           한 단어가 칸보다 길 때만 단어 안에서 끊는다(break-word) */
      html {
        overflow-wrap: break-word;
        text-wrap: pretty;
      }
      html:lang(ko) {
        word-break: keep-all;
      }
      html:lang(en) {
        word-break: normal;
      }
      html:lang(ja) {
        word-break: normal;
        word-break: auto-phrase;
        line-break: strict;
      }
      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
      /* 손가락으로 조작하는 기기에서는 누를 수 있는 요소를 44×44px 이상으로 (Fluent 2 웹 터치 최소 크기) */
      @media (pointer: coarse) {
        html .fui-Button,
        html .fui-ToggleButton,
        html .fui-MenuButton,
        html .fui-NavItem,
        html .fui-Tab {
          min-height: 44px;
          min-width: 44px;
        }
      }
      .boot {
        min-height: 100vh;
        display: grid;
        place-items: center;
        color: var(--page-fg);
        font: 14px "Segoe UI", "Malgun Gothic", system-ui, sans-serif;
      }
    </style>
  </head>
  <body>
    <App client:only="react">
      <div slot="fallback" class="boot">Security Glance</div>
    </App>
  </body>
</html>
