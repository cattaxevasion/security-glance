// 속보 감시 Worker 설정. 배포: worker 폴더에서 npx wrangler deploy
{
  "name": "security-glance-watch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 바깥에 주소를 열지 않는다 (예약 실행만)
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "SEEN", "id": "1e67b2c98ea44d9d95289fb93f27fc1f" }],
  "vars": {
    "GITHUB_REPO": "cattaxevasion/security-glance",
    "WORKFLOW": "update.yml"
  },
  "observability": { "enabled": true }
}
